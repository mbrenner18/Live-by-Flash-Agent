import express from 'express';
import path from 'path';
import { fileURLToPath } from 'url';

const __filename = fileURLToPath(import.meta.url);
const __dirname = path.dirname(__filename);

const app = express();
const PORT = process.env.PORT || 8080; // Cloud Run uses 8080

// 1. Serve the static files from the Vite build directory
app.use(express.static(path.join(__dirname, 'dist')));

// 2. Health check (optional but recommended for Cloud Run)
app.get('/health', (req, res) => {
  res.status(200).send('OK');
});

// 3. The "Catch-All" route
// This handles the "MIME type text/html" error by ensuring that if a user
// refreshes on /dashboard, the server provides index.html so React can take over.
app.get('*', (req, res) => {
  res.sendFile(path.join(__dirname, 'dist', 'index.html'));
});

app.listen(PORT, () => {
  console.log(`Server is running on port ${PORT}`);
});
